# ============================================================================
# OrgMind / SNS Workbench: Frontend Environment Variables
# ============================================================================

# SNS Agent Workbench Webhook URL (POST endpoint)
VITE_AI_WORKFLOW_WEBHOOK_URL=https://agents.snsihub.ai/webhook/your-workflow-id
AI_WORKFLOW_WEBHOOK_URL=https://agents.snsihub.ai/webhook/your-workflow-id

# Supabase Configuration
# Found at: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional Port for local frontend server (default: 3000)
PORT=3000
